rules_version = '2';
// みんなの在庫帳 — Firestore のルール
// 合言葉なし：URL を知っている人は誰でも見て、変更できます。
// そのかわり、保存できる内容（項目名・文字数・数値）を厳しく制限しています。
service cloud.firestore {
  match /databases/{database}/documents {

    function str(v, max) { return v is string && v.size() <= max; }
    function qty(v) { return (v is int || v is float) && v >= 0 && v <= 1000000; }

    function validItem(d) {
      return d.keys().hasOnly(['name', 'category', 'qty', 'unit', 'min', 'place', 'note',
                               'createdAt', 'updatedAt', 'updatedBy', 'updatedByName'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && qty(d.qty)
        && (!('min' in d) || qty(d.min))
        && (!('category' in d) || str(d.category, 30))
        && (!('unit' in d) || str(d.unit, 10))
        && (!('place' in d) || str(d.place, 40))
        && (!('note' in d) || str(d.note, 200))
        && (!('updatedBy' in d) || d.updatedBy == null || str(d.updatedBy, 40))
        && (!('updatedByName' in d) || str(d.updatedByName, 20))
        && (!('createdAt' in d) || d.createdAt is number)
        && (!('updatedAt' in d) || d.updatedAt is number);
    }

    function validHist(d) {
      return d.keys().hasOnly(['date', 'itemId', 'name', 'unit', 'inc', 'dec', 'endQty', 'at', 'by'])
        && str(d.date, 10) && str(d.itemId, 40) && str(d.name, 60) && str(d.unit, 10)
        && qty(d.inc) && qty(d.dec) && qty(d.endQty)
        && d.at is number
        && (d.by == null || str(d.by, 40));
    }

    function validEvent(d) {
      return d.keys().hasOnly(['date', 'itemId', 'name', 'unit', 'delta', 'qty', 'at', 'by', 'byName'])
        && str(d.date, 10) && str(d.itemId, 40) && str(d.name, 60) && str(d.unit, 10)
        && d.delta is number && d.delta >= -1000000 && d.delta <= 1000000
        && qty(d.qty)
        && d.at is number
        && (d.by == null || str(d.by, 40))
        && str(d.byName, 20);
    }

    match /items/{id} {
      allow read: if true;
      allow create, update: if validItem(request.resource.data);
      allow delete: if true;
    }

    match /history/{id} {
      allow read: if true;
      allow create, update: if validHist(request.resource.data);
      allow delete: if false;
    }

    match /events/{id} {
      allow read: if true;
      allow create: if validEvent(request.resource.data);
      allow update, delete: if false;
    }
  }
}
